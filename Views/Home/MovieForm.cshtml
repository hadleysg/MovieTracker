@{
    ViewData["Title"] = "Enter a New Movie";
}

@model Movie

<div class="container mt-5">
    <h1 class="display-4 mb-4">@ViewData["Title"]</h1>

    <form asp-action="MovieForm" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="MovieId" /> <!-- This is added on to insure that the movieid is the same when editing-->

        <div class="mb-3">
            <label for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="mb-3">
            <label for="Director" class="form-label">Director</label>
            <input asp-for="Director" class="form-control" required />
        </div>

        <div class="mb-3">
            <label for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" class="form-select" id="CategoryId" required>
                <option value="">Select a Category</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.CategoryId">@category.CategoryName</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="Year" class="form-label">Year</label>
            <input asp-for="Year" type="number" class="form-control" required min="1888" />
        </div>

        <div class="mb-3">
            <label for="Rating" class="form-label">Rating</label>
            <select asp-for="Rating" class="form-select">
                <option value="G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="Edited" class="form-label">Edited</label>
            <select asp-for="Edited" class="form-select">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="LentTo" class="form-label">Lent To</label>
            <input asp-for="LentTo" class="form-control" />
        </div>

        <div class="mb-3">
            <label for="CopiedToPlex" class="form-label">Copied To Plex</label>
            <select asp-for="CopiedToPlex" class="form-select">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="Notes" class="form-label">Notes (Max 25 characters)</label>
            <input asp-for="Notes" class="form-control" maxlength="25" />
        </div>

        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>


