@{
}

@model List<Movie>

<table class="table table-bordered">
    <thead class="fw-bold">
        <tr>
            <td>Title</td>
            <td>Director</td>
            <td>Category</td>
            <td>Year</td>
            <td>Rating</td>
            <td>Edited</td>
            <td>LentTo</td>
            <td>Copied To Plex</td>
            <td>Notes</td>
            <td>Edit or Delete</td>
        </tr>
    </thead>

    @foreach (var x in Model)
    {
        <tbody>
            <tr>
                <td>@x.Title</td>
                <td>@x.Director</td>
                <td>@x.Category?.CategoryName</td>
                <td>@x.Year</td>
                <td>@x.Rating</td>
                <td>@x.Edited</td>
                <td>@x.LentTo</td>
                <td>@x.CopiedToPlex</td>
                <td>@x.Notes</td>
                <td class="d-flex">
                    <a class="btn btn-info mr-2" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a>
                    <a class="btn btn-danger" asp-controller="Home" asp-action="DeleteConfirmation" asp-route-id="@x.MovieId">Delete</a>
                </td>

            </tr>
        </tbody>
    }

</table>


